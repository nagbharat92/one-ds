{
  "name": "oneds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "icons:update-font": "node scripts/update-material-symbols.mjs",
    "test:icons": "node --test scripts/test-icons.mjs",
    "test:tokens": "node scripts/check-design-tokens.mjs",
    "predev": "node scripts/generate-if-stale.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-design-rules.mjs && node scripts/generate-showcase-code.mjs && node --experimental-strip-types scripts/generate-agent-catalog.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run test:icons && npm run test:tokens",
    "rules:generate": "node scripts/generate-design-rules.mjs",
    "test:design-rules": "node scripts/generate-design-rules.mjs --check && node --test scripts/test-design-rules.mjs",
    "test:color-theme": "node --experimental-strip-types --test scripts/test-color-theme.mjs",
    "test:annotations": "node --experimental-strip-types --test scripts/test-annotation-layout.mjs scripts/test-annotation-measurements.mjs",
    "test:showcase-code": "node scripts/generate-showcase-code.mjs && node --test scripts/test-showcase-code-source.mjs scripts/test-showcase-snippets.mjs",
    "catalog:generate": "node --experimental-strip-types scripts/generate-agent-catalog.mjs",
    "catalog:list": "node scripts/agent-catalog-cli.mjs list",
    "catalog:show": "node scripts/agent-catalog-cli.mjs show",
    "catalog:example": "node scripts/agent-catalog-cli.mjs example",
    "catalog:check": "node scripts/agent-catalog-cli.mjs check",
    "test:preview-tools": "playwright test",
    "showcase:code": "node scripts/generate-showcase-code.mjs",
    "test:catalog": "node --experimental-strip-types --test scripts/test-agent-catalog.mjs",
    "build:core-pilot": "vite build --config vite.core-pilot.config.ts --logLevel error && vite build --config vite.material-theme.config.ts --logLevel error",
    "test:core-pilot": "npm run build:core-pilot && node --test scripts/test-core-pilot-package.mjs",
    "lab:refresh-core": "npm --prefix ../oneds-consumer-lab run refresh:core",
    "build:button-pilot": "npm run build:core-pilot",
    "test:button-pilot": "npm run test:core-pilot",
    "lab:refresh-button": "npm run lab:refresh-core",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@material/material-color-utilities": "0.3.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "flubber": "^0.4.2",
    "input-otp": "^1.5.0",
    "katex": "^0.18.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^8.0.0-beta.3",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@playwright/test": "^1.63.0",
    "@types/flubber": "^0.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
